{
  "name": "deployhub",
  "version": "1.0.0",
  "description": "DeployHub - Developer Deployment & Hosting Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon",
    "dev:client": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "start:dev": "ts-node server/index.ts",
    "serve": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1146.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.8.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.6",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.8",
    "node-unrar-js": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^5.4.14"
  },
  "keywords": [
    "deploy",
    "hosting",
    "developer-platform",
    "vite",
    "php",
    "static"
  ],
  "author": "DeployHub Team",
  "license": "MIT"
}
