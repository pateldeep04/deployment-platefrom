# DeployHub Environment Configuration

# API Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
JWT_SECRET=super-secret-deployhub-jwt-token-key-change-in-production-32chars
JWT_REFRESH_SECRET=super-secret-deployhub-refresh-token-key-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Databases & Cache (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/deployhub?retryWrites=true&w=majority
# MONGODB_URI=mongodb://localhost:27017/deployhub
REDIS_URL=redis://localhost:6379

# Storage Paths
STORAGE_DIR=../../storage
UPLOAD_MAX_SIZE_MB=100
STORAGE_QUOTA_FREE_MB=500

# Edge Domain Routing
PLATFORM_DOMAIN=deployhub.local
EDGE_PORT=5000

# Razorpay Integration (Test / Sandbox)
RAZORPAY_KEY_ID=rzp_test_deployhub_sandbox_key
RAZORPAY_KEY_SECRET=rzp_test_deployhub_sandbox_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_key

# Admin Seed
ADMIN_EMAIL=admin@deployhub.com
ADMIN_PASSWORD=AdminDeployHub2026!

# AWS EC2 Primary Node Integration
PRIMARY_SERVER_IP=13.127.231.134
AWS_REGION=ap-south-1
AWS_EC2_INSTANCE_ID=i-089bcd5af2cb5b8f3

# Email / SMTP Configuration (for Gmail, Brevo, AWS SES, or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="DeployHub Cloud" <your-email@gmail.com>


