# ==============================================================================
# DeployHub Platform Environment Configuration Example
# ==============================================================================

# Core Application Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Client Frontend Environment
VITE_PLATFORM_DOMAIN=deployhub.local

# Security & Authentication (JWT Secrets)
JWT_SECRET=super-secret-deployhub-jwt-token-key-change-in-production-32chars
JWT_REFRESH_SECRET=super-secret-deployhub-refresh-token-key-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Superuser / Administrator Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-to-your-strong-password

# Databases & Cache
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/deployhub?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Storage & File Upload Quotas
STORAGE_DIR=./storage
UPLOAD_MAX_SIZE_MB=100
STORAGE_QUOTA_FREE_MB=5000

# Edge Routing & Subdomain Routing
PLATFORM_DOMAIN=deployhub.local
EDGE_PORT=5000

# Namecheap DNS Automation
NAMECHEAP_SLD=yourdomain
NAMECHEAP_TLD=com
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=
# NAMECHEAP_USERNAME=
# NAMECHEAP_CLIENT_IP=127.0.0.1
# NAMECHEAP_USE_SANDBOX=false

# Platform Host & Server
SERVER_IP=127.0.0.1

# Email / SMTP Notification Service (Gmail, SES, Brevo, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="DeployHub Cloud" <your-email@gmail.com>
