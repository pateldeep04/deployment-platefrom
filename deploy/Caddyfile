# ==============================================================================
# DeployHub Production Caddyfile
# Zero-downtime reverse proxy, automated on-demand TLS, and static file serving
# ==============================================================================

{
    # Global on-demand TLS configuration
    # Only issues TLS certificates for verified domains via DeployHub internal API
    on_demand_tls {
        ask http://127.0.0.1:5000/internal/tls-ask
        interval 2m
        burst 5
    }

    # Security: auto HTTPS with HTTP/2 and HTTP/3 support
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
    }
}

# ------------------------------------------------------------------------------
# 1. Main Dashboard & Control Plane (DeployHub Platform)
# ------------------------------------------------------------------------------
deployhub.app, www.deployhub.app, localhost:3000 {
    # React Dashboard Frontend
    root * /var/www/deployhub/dist
    file_server

    # Compression
    encode zstd gzip

    # Proxy API and WebSocket requests to internal Node.js backend
    handle /api/* {
        reverse_proxy 127.0.0.1:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Internal endpoints are blocked from public ingress
    handle /internal/* {
        respond "Access Denied" 403
    }

    # SPA Fallback: routing handled by React Router
    try_files {path} /index.html
}

# ------------------------------------------------------------------------------
# 2. Platform Tenant Wildcard Subdomains (*.pateldeeep.me, *.deployeai.duckdns.org)
# ------------------------------------------------------------------------------
*.pateldeeep.me, *.deployeai.duckdns.org {
    encode zstd gzip

    # Section 4.1: Tenant Security Isolation Headers
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Reverse proxy to DeployHub edge proxy for tenant resolution, ad injection, and site routing
    reverse_proxy 127.0.0.1:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ------------------------------------------------------------------------------
# 3. Custom Domains with Automated On-Demand TLS
# ------------------------------------------------------------------------------
:443 {
    tls {
        on_demand
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    # Proxy to DeployHub edge proxy for custom domain resolution
    reverse_proxy 127.0.0.1:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

